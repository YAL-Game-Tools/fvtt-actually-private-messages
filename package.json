{
	"main": "dist/private-rolls.mjs",
	"devDependencies": {
		"@league-of-foundry-developers/foundry-vtt-types": "^13.345.1",
		"@stylistic/eslint-plugin-js": "^4.4.1",
		"eslint": "^9.33.0",
		"eslint-plugin-jsdoc": "^54.1.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.5",
		"prettier": "^3.6.2"
	},
	"engines": {
		"bun": ">=1.1.21"
	},
	"lint-staged": {
		"*.mjs": "eslint --cache --fix --quiet",
		"*.json": "prettier --write"
	},
	"private": true,
	"scripts": {
		"lint:js": "bunx eslint . --quiet --cache",
		"lint:js:fix": "bunx eslint . --quiet --cache --fix",
		"release": "bun rebuild && bun ./scripts/release.mjs",
		"build": "bun js && bun css && bun sync",
		"rebuild": "bun run build",
		"sync": "bun ./scripts/sync-files.mjs",
		"sync:watch": "bun ./scripts/sync-files.mjs --watch",
		"js": "bun build src/private-rolls.mjs --sourcemap=linked --minify-whitespace --outdir dist --entry-naming [name].mjs",
		"js:watch": "bun build src/private-rolls.mjs --sourcemap=linked --minify-whitespace --outdir dist --entry-naming [name].mjs --watch",
		"css": "bun build css/private-rolls.css --minify-whitespace --outdir dist --entry-naming [name].css",
		"css:watch": "bun build css/private-rolls.css --minify-whitespace --outdir dist --entry-naming [name].css --watch",
		"prettier": "bunx prettier --write --cache ."
	},
	"source": "private-rolls.mjs",
	"type": "module"
}
