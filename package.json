{
	"main": "dist/private-rolls.mjs",
	"devDependencies": {
		"@league-of-foundry-developers/foundry-vtt-types": "^13.340.1",
		"@stylistic/eslint-plugin-js": "^4.2.0",
		"eslint": "^9.25.1",
		"eslint-plugin-jsdoc": "^50.6.11",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"prettier": "^3.5.3",
		"sass": "^1.87.0"
	},
	"engines": {
		"bun": ">=1.1.21"
	},
	"lint-staged": {
		"*.mjs": "eslint --cache --fix --quiet",
		"*.json": "prettier --write"
	},
	"private": true,
	"scripts": {
		"lint:js": "bunx eslint . --quiet --cache",
		"lint:js:fix": "bunx eslint . --quiet --cache --fix",
		"release": "bun run build && bun ./scripts/release.mjs",
		"build": "bun run js && bun run css && bun run sync",
		"rebuild": "bun run build",
		"sync": "bun ./scripts/sync-files.mjs",
		"sync:watch": "bun ./scripts/sync-files.mjs --watch",
		"js": "bun build src/private-rolls.mjs --sourcemap=linked --minify-whitespace --outdir dist --entry-naming [name].mjs",
		"js:watch": "bun build src/private-rolls.mjs --sourcemap=linked --minify-whitespace --outdir dist --entry-naming [name].mjs --watch",
		"css": "bunx sass -s compressed ./scss/private-rolls.scss ./dist/private-rolls.css",
		"css:watch": "bunx sass -s compressed --watch ./scss/private-rolls.scss ./dist/private-rolls.css",
		"prettier": "bunx prettier --write --cache ."
	},
	"source": "private-rolls.mjs",
	"type": "module"
}
