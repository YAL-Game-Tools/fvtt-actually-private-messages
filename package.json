{
	"main": "dist/private-rolls.mjs",
	"devDependencies": {
		"@league-of-foundry-developers/foundry-vtt-types": "^9.280.0",
		"@stylistic/eslint-plugin-js": "^2.4.0",
		"chokidar": "^3.6.0",
		"eslint": "^9.8.0",
		"eslint-plugin-jsdoc": "^48.8.3",
		"eslint-plugin-optimize-regex": "^1.2.1",
		"husky": "^9.1.3",
		"lint-staged": "^15.2.7",
		"prettier": "^3.3.3",
		"sass": "^1.77.8"
	},
	"engines": {
		"bun": ">=1.1.21"
	},
	"lint-staged": {
		"*.mjs": "eslint --cache --fix",
		"*.json": "prettier --write"
	},
	"private": true,
	"scripts": {
		"lint:js": "npx eslint . --ext js,mjs --cache",
		"lint:js:fix": "npx eslint . --ext js,mjs --cache --fix",
		"release": "bun run build && bun ./scripts/release.mjs",
		"build": "bun run js && bun run css && bun run sync",
		"sync": "bun ./scripts/sync-files.mjs",
		"sync:watch": "bun ./scripts/sync-files.mjs --watch",
		"js": "bun build src/private-rolls.mjs --sourcemap=linked --minify-whitespace --outdir dist --entry-naming [name].mjs",
		"js:watch": "bun build src/private-rolls.mjs --sourcemap=linked --minify-whitespace --outdir dist --entry-naming [name].mjs --watch",
		"css": "npx sass -s compressed ./scss/private-rolls.scss ./dist/private-rolls.css",
		"css:watch": "npx sass -s compressed --watch ./scss/private-rolls.scss ./dist/private-rolls.css",
		"prettier": "prettier --write --cache ."
	},
	"source": "private-rolls.mjs",
	"type": "module"
}
