{
	"source": "private-rolls.mjs",
	"engines": {
		"node": ">=16.0.0"
	},
	"type": "module",
	"devDependencies": {
		"@league-of-foundry-developers/foundry-vtt-types": "^9.280.0",
		"chokidar": "^3.5.3",
		"esbuild": "^0.19.2",
		"eslint": "^8.47.0",
		"eslint-plugin-jsdoc": "^46.4.6",
		"eslint-plugin-optimize-regex": "^1.2.1",
		"husky": "^8.0.3",
		"lint-staged": "^14.0.0",
		"prettier": "^3.0.2",
		"sass": "^1.66.0"
	},
	"lint-staged": {
		"*.mjs": "eslint --cache --fix",
		"*.json": "prettier --write"
	},
	"scripts": {
		"lint:js": "npx eslint . --ext js,mjs --cache",
		"lint:js:fix": "npx eslint . --ext js,mjs --cache --fix",
		"release": "npm run build && node ./scripts/release.mjs",
		"build": "npm run js && npm run css && npm run sync",
		"sync": "node ./scripts/sync-files.mjs",
		"sync:watch": "node ./scripts/sync-files.mjs --watch",
		"js": "node ./scripts/build.mjs",
		"js:watch": "node ./scripts/build.mjs --watch",
		"css": "npx sass -s compressed ./scss/private-rolls.scss ./dist/private-rolls.css",
		"css:watch": "npx sass -s compressed --watch ./scss/private-rolls.scss ./dist/private-rolls.css",
		"prettier": "prettier --write --cache ."
	},
	"private": true
}
